rules_version = '2';

// CrazyGolfGame security rules.
//
// These rules are the actual lock on the data - the API key in the client bundle
// is public by design and protects nothing. Everything below assumes a small,
// known group of friends, so the model is "signed-in users can see the round,
// but can only write their own stuff".
//
// Tested in tests/unit/firestore-rules.test.ts against the emulator. If you change
// a rule, change a test.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admins are listed by hand in the Firebase console. There is deliberately no
    // self-service path to becoming one - a document nobody can write from the app
    // sidesteps the bootstrap problem without needing a server or custom claims.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Player profiles. Readable by any signed-in user because you need your playing
    // partners' names and avatars on the leaderboard. Writable only by the owner,
    // or by an admin performing the password reset described in REQUIREMENTS.md §3.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();

      // Which rounds this player has been in (T-9.1). Firestore rules do not
      // cascade into subcollections, so this needs saying even though the parent
      // document is already covered above.
      //
      // Written by the player as they join, and read back as their history. Kept
      // per-user rather than queried out of the rounds collection because a
      // collection-group query over every round's players would need its own
      // index and would let anyone enumerate everyone's golf. This way a player's
      // history is theirs, and the query is a plain read of a path they own.
      match /rounds/{roundId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }
    }

    // Course data is reference data: everyone reads it, only an admin edits it.
    // This is what stops a player quietly moving a green closer to their ball.
    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /holes/{holeId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // The card catalogue, edited in-app by an admin between play tests.
    match /cards/{cardId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Thumbs up / thumbs down on a card. Everyone sees the totals, so a vote has
    // to be worth something: the document id is `{cardId}_{uid}`, which makes one
    // vote per player per card a property of the path rather than a hope. The id
    // check is what stops somebody writing a vote into another player's slot.
    match /cardVotes/{voteId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && voteId == request.resource.data.cardId + '_' + request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Cards players have written and sent to the admin for a decision.
    //
    // Readable by the person who suggested it and by an admin, and by nobody
    // else - a rejection is between the two of them. A listing therefore has to
    // filter on suggestedBy, which the suggestion library does.
    match /cardSuggestions/{suggestionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.suggestedBy == request.auth.uid);
      // A suggestion always arrives pending and always in your own name. Nobody
      // gets to submit a pre-approved card, or one attributed to someone else.
      allow create: if signedIn()
        && request.resource.data.suggestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only the admin decides, and the decision is the only thing that changes.
      allow update, delete: if isAdmin();
    }

    match /rounds/{roundId} {

      function isPlayer() {
        return signedIn()
          && exists(/databases/$(database)/documents/rounds/$(roundId)/players/$(request.auth.uid));
      }

      function round() {
        return get(/databases/$(database)/documents/rounds/$(roundId)).data;
      }

      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isPlayer() || isAdmin();
      allow delete: if isAdmin();

      // You add yourself to a round; you don't add other people.
      match /players/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid);
        allow update, delete: if isSelf(uid) || isAdmin();
      }

      // REQUIREMENTS.md §4.2: each player enters their own score. Enforced here
      // rather than only in the UI. When the deferred "group can edit anyone's
      // score" feature lands, this is the rule that has to change.
      match /scores/{scoreId} {
        allow read: if signedIn();
        allow create, update: if isPlayer() && request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin();
      }

      // Hands honour the round's secret/open setting from REQUIREMENTS.md §4.4.
      // Doing this in rules rather than the UI means "secret" actually means secret -
      // a curious player cannot read a rival's hand out of the network tab.
      match /hands/{uid} {
        allow read: if isSelf(uid)
          || isAdmin()
          || round().settings.cardVisibility == 'open';
        allow create, update: if isSelf(uid) || isAdmin();
        allow delete: if isAdmin();
      }

      // The event feed is an append-only audit trail. Cards are honour-system, so
      // this log is the only record of what happened - it must not be rewritable,
      // and you can only speak as yourself.
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if isPlayer() && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Anything not matched above is denied.
  }
}
